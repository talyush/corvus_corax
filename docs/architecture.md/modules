## 📄 Unified Output Schema Contract

Every module output follows a strict schema to ensure modularity and unified processing:

```json
{
  "module": "scan",
  "target": "192.168.1.10",
  "status": "success",
  "data": {
    "ip": "192.168.1.10",
    "mode": "normal",
    "open_ports": [{"port": 80, "service": "HTTP"}]
  },
  "notes": [
    {
      "text": "Port 80 (HTTP) discovered open on 192.168.1.10",
      "source": "scan",
      "severity": "info",
      "confidence": 1.0,
      "timestamp": "2026-05-24T17:15:00.000000+00:00"
    }
  ],
  "relationships": [
    {
      "src": {"type": "ip", "value": "192.168.1.10"},
      "relation": "has_open_port",
      "dst": {"type": "port", "value": "80/HTTP"},
      "evidence": "port scan",
      "confidence": 1.0,
      "timestamp": "2026-05-24T17:15:00.000000+00:00"
    }
  ],
  "timestamp": "2026-05-24T17:15:00.000000+00:00"
}
```

