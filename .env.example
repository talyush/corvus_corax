# ============================================================
# Corvus Corax v1.3.2 — LLM & Yapılandırma (.env şablonu)
# Bu dosyayı kopyalayıp `.env` olarak kaydedin ve değerleri doldurun.
# Kopya:  cp .env.example .env      (Windows: copy .env.example .env)
#
# ÖNEMLİ: `.env` dosyası .gitignore'da olduğu için commit edilmez —
# anahtarlarınız yalnızca sizde kalır.
# ============================================================

# ------------------------------------------------------------
# OLLAMA (yerel LLM) — Corvus'un varsayılan zihin sesi
# ------------------------------------------------------------
# Host: Ollama `ollama serve` ile çalışıyorsa genelde bu adrestedir.
CORVUS_OLLAMA_HOST=http://localhost:11434
# Model: boş bırakılırsa otomatik tespit (qwen2.5-coder -> qwen2.5 -> llama3...)
CORVUS_OLLAMA_MODEL=qwen2.5-coder:7b

# ------------------------------------------------------------
# OpenAI (opsiyonel) — anahtar set edilirse cloud GPT kullanılır
# ------------------------------------------------------------
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# Anthropic (opsiyonel) — anahtar set edilirse Claude kullanılır
# ------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx