  "relationship_policies": {
    "phone_to_person": {
      "type": "candidate",
      "default_confidence": 0.4,
      "evidence_required": true,
      "description": "Telefon numarası kişiye aday olarak bağlanır — kesin sahiplik kanıtı yok"
    },
    "username_match": {
      "type": "possible",
      "base_confidence": 0.15,
      "confidence_boost_per_platform": 0.1,
      "max_confidence": 0.7,
      "description": "Aynı kullanıcı adı farklı kişilere ait olabilir — olasılık modeli"
    },
    "email_to_person": {
      "type": "candidate",
      "dmarc_confidence": 0.3,
      "breach_confidence": 0.2,
      "staff_email_confidence": 0.5,
      "description": "DMARC/breach/staff verisi tek başına kesin email sahipliği kanıtı değildir"
    },
    "org_to_domain": {
      "type": "candidate",
      "default_confidence": 0.6,
      "evidence_required": true,
      "description": "Organizasyon-domain bağlantısı aday — WHOIS/ASN verisi tek başına kesin değil"
    },
    "academic_affiliation": {
      "type": "candidate",
      "default_confidence": 0.7,
      "evidence_required": true,
      "description": "Akademik kurum bağlantısı — yayın/paper verisinden aday"
    },
    "wallet_to_person": {
      "type": "candidate",
      "default_confidence": 0.4,
      "evidence_required": true,
      "description": "Kripto cüzdan kişiye aday — cüzdanlar paylaşılabilir"
    },
    "github_email_correlation": {
      "type": "possible",
      "default_confidence": 0.6,
      "evidence_required": true,
      "description": "GitHub'da aynı email/kullanıcı adı — olası eşleşme"
    },
    "web_history_correlation": {
      "type": "possible",
      "default_confidence": 0.4,
      "evidence_required": true,
      "description": "Wayback geçmişi aynı domain — olası içerik ilişkisi"
    }
  },
  "breach_sources": {
    "firefox_monitor": {
      "type": "public_api",
      "api_key_required": false,
      "description": "Firefox Monitor — HIBP verisini kullanır, API anahtarı gerekmez"
    },
    "hibp_pwned_passwords": {
      "type": "k_anonymity",
      "api_key_required": false,
      "description": "HIBP Pwned Passwords — k-anonimlik, şifrenin tamamı asla gönderilmez"
    },
    "manual": {
      "type": "user_provided",
      "api_key_required": false,
      "description": "Kullanıcı tarafından sağlanan breach listesi"
    }
