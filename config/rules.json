    "anomaly_threshold": 70,
    "min_events_for_analysis": 5,
    "timezone": "Europe/Istanbul",
    "movement_vpn_warning": true,
    "vault_dir": "vault",
    "persist_confidence_threshold": 0.5,
    "night_activity_hours": [0, 1, 2, 3, 4, 5],
    "anomaly_zscore_threshold": 2.0,
    "description": "Pattern of Life analiz politikaları — davranış deseni, anomali tespiti, vault"
  },
